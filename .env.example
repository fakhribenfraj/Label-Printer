# From Converty dashboard: Integrations > Custom apps > New app
CONVERTY_CLIENT_ID=
CONVERTY_CLIENT_SECRET=
# Public base URL of this app. Register APP_URL/api/auth/callback as a redirect URI in Converty.
APP_URL=http://localhost:3000
# Label defaults (the Converty API has no origin city / fragile / open-parcel fields)
ORIGIN_CITY=NABEUL
FRAGILE=1
OPEN_PARCEL=1
